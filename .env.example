# Frontend
VITE_API_BASE=http://localhost:3200
VITE_ENVIRONMENT=development
VITE_GOOGLE_AUTH_ENABLED=false
VITE_GOOGLE_CLIENT_ID=

# API runtime
SNIPPETS_API_BACKEND=json-server
API_PORT=3200
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
SESSION_COOKIE_NAME=snippets_session
SESSION_COOKIE_SECRET=change-this-session-secret

# Database-backed API
SNIPPETS_DATABASE_PROVIDER=postgres
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_DB=snippets
POSTGRES_USER=snippets
POSTGRES_PASSWORD=snippets
POSTGRES_PORT=5432
POSTGRES_SSL=false
SHARED_POSTGRES_NETWORK=shared-services

# Local Postgres (docker-compose.postgres.yml)
# By default, `SNIPPETS_API_BACKEND=database npm run api` automatically starts
# a Postgres Docker container (docker-compose.postgres.yml) and waits for it
# to be healthy before the API server starts.  Data persists across restarts
# via the named Docker volume `postgres_data`.
#
# Set POSTGRES_USE_LOCAL=true to skip Docker entirely and connect to a
# locally-installed Postgres instance instead (useful if you already have
# Postgres running natively and don't want Docker involved).
POSTGRES_USE_LOCAL=false

# AWS RDS connection (used by scripts/apply-migrations.sh)
RDS_HOST=example.cluster-abcdefghijkl.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB=snippets
RDS_USER=snippets
RDS_PASSWORD=change-me
