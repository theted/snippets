        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/lang-yaml": "^6.1.2",
        "@codemirror/language": "^6.11.1",
        "@codemirror/legacy-modes": "^6.5.2",
        "@codemirror/state": "^6.5.2",
        "@codemirror/theme-one-dark": "^6.1.3",
        "@codemirror/view": "^6.36.6",
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.2.0",
        "@tanstack/react-query": "^5.0.0",
        "@tanstack/react-query-devtools": "^5.0.0",
        "@uiw/react-codemirror": "^4.25.8",
        "axios": "^1.13.6",
        "classnames": "^2.5.1",
        "dotenv": "^17.3.1",
        "fastify": "^5.8.2",
        "google-auth-library": "^10.6.2",
        "gsap": "^3.14.2",
        "masonic": "^4.1.0",
        "pg": "^8.20.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.71.2",
        "react-router-dom": "^7.13.1",
        "react-syntax-highlighter": "^15.6.1",
        "web-vitals": "^4.2.4",
        "zod": "^3.25.76"
    },
    "scripts": {
        "api": "node ./scripts/start-api.mjs",
        "api:json": "json-server --watch data/db.json --middlewares ./middleware.js --port 3200",
        "api:db": "tsx server/index.ts",
        "start": "vite",
        "build": "vite build",
        "build:api": "tsc -p tsconfig.server.json",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "dev-server": "node ./scripts/start-api.mjs",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
        "lint": "eslint .",
        "analyze": "source-map-explorer 'dist/assets/*.js'"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.0.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.0.0",
        "@types/pg": "^8.18.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@typescript-eslint/eslint-plugin": "^8.57.1",
        "@typescript-eslint/parser": "^8.57.1",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^8.57.1",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^4.6.2",
        "jsdom": "^29.0.0",
        "json-server": "^0.17.4",
        "postcss": "^8.5.8",
        "source-map-explorer": "^2.5.3",
        "tailwindcss": "^4.0.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.0"
    }
}
