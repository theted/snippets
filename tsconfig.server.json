{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "es2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "./server-dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "allowJs": false,
    "isolatedModules": false,
    "noImplicitAny": true
  },
  "include": [
    "server/**/*.ts",
    "src/types.ts"
  ]
}
